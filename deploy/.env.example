# Copy to .env and fill in all values. Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=livedata
# Strong random password — e.g. openssl rand -base64 32
POSTGRES_PASSWORD=changeme_use_strong_password
POSTGRES_DB=livedata_prod

# ── Phoenix application ───────────────────────────────────────────────────────
# Bare hostname, no scheme, no trailing slash (see docs/contributing/deployment.md)
PHX_HOST=your.domain.example
# Generate: mix phx.gen.secret  (must be ≥ 64 bytes)
SECRET_KEY_BASE=changeme_run_mix_phx_gen_secret

# ── Caddy ─────────────────────────────────────────────────────────────────────
# Must match PHX_HOST exactly
LIVEDATA_DOMAIN=your.domain.example

# ── Optional ──────────────────────────────────────────────────────────────────
# Docker image tag for livedata (default: livedata:latest)
# LIVEDATA_IMAGE=livedata:latest

# Ecto connection pool size (default: 10)
# POOL_SIZE=10
