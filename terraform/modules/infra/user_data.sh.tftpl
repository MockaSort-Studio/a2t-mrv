#!/bin/bash
# Install the CodeDeploy agent on Amazon Linux 2023.
# Runs once at first boot via cloud-init. All output is captured in
# /var/log/user-data.log and forwarded to syslog for CloudWatch pickup.
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data -s) 2>&1

echo "[$(date -Iseconds)] Starting user-data: installing CodeDeploy agent"

# Region is injected by Terraform at plan time — no IMDS dependency at boot.
# Write to a config file so deploy scripts can read the region without IMDS.
REGION="${region}"
mkdir -p /etc/livedata
echo "$REGION" > /etc/livedata/region

dnf install -y ruby wget
cd /tmp
wget -q "https://aws-codedeploy-$REGION.s3.$REGION.amazonaws.com/latest/install"
chmod +x ./install
./install auto
systemctl enable codedeploy-agent

echo "[$(date -Iseconds)] CodeDeploy agent installed and enabled (region: $REGION)"
