#!/usr/bin/env bash
# Install the AWS CodeDeploy agent on a NixOS host.
# Runs once at first boot via amazon-init. Subsequent reboots are handled
# by the systemd service that this script enables.
set -euo pipefail

LOG=/var/log/codedeploy-agent-install.log
exec >> "$LOG" 2>&1
echo "[$(date -Iseconds)] Starting CodeDeploy agent installation"

# Nix package manager provides the Ruby runtime; install into root's profile
# so binaries persist in /root/.nix-profile across reboots.
nix-env -iA nixpkgs.ruby
export PATH="/root/.nix-profile/bin:$PATH"

# Install the CodeDeploy agent gem (Ruby-based; works on any Linux with Ruby).
gem install aws-sdk-core --no-document --quiet
gem install codedeploy-agent --no-document --quiet

AGENT_BIN="$(ruby -e 'puts Gem.bindir')/codedeploy-agent"

# Directories expected by the agent at runtime.
mkdir -p /opt/codedeploy-agent/conf \
         /opt/codedeploy-agent/state/.pid \
         /opt/codedeploy-agent/deployment-root \
         /var/log/aws/codedeploy-agent

cat > /opt/codedeploy-agent/conf/codedeployagent.yml << 'CONF'
---
:log_aws_wire: false
:log_dir: '/var/log/aws/codedeploy-agent'
:pid_dir: '/opt/codedeploy-agent/state/.pid'
:program_name: codedeploy-agent
:root_dir: '/opt/codedeploy-agent/deployment-root'
:verbose: false
:wait_between_runs: 1
:on_premises_config_file: '/etc/codedeploy-agent/conf/onpremises.yml'
:proxy_uri:
:max_revisions: 5
CONF

# Write the systemd unit.  /etc/systemd/system/ is a real directory on NixOS
# (not a Nix-store symlink) and custom units placed here survive nixos-rebuild.
cat > /etc/systemd/system/codedeploy-agent.service << UNIT
[Unit]
Description=AWS CodeDeploy Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=$AGENT_BIN
Restart=on-failure
RestartSec=5
Environment=PATH=/root/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now codedeploy-agent

echo "[$(date -Iseconds)] CodeDeploy agent installation complete"
