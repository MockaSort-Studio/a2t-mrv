#!/bin/sh
# Migrate, seed, then serve — the platform start command (see render.yaml).
#
# Kept as a script rather than a shell one-liner in the platform config so the
# chain is a single argv token: no assumption about whether the platform
# interprets `&&`. `set -e` means a failed migration never reaches the server.
set -eu
cd -P -- "$(dirname -- "$0")"
./migrate
./seed
exec ./server
