# The build context is livedata/ (see livedata/Dockerfile). Everything below
# would either be rebuilt inside the image anyway or actively poison the build:
# host-compiled _build/ and deps/ carry artefacts from a different OS and
# MIX_ENV, and stale digested assets would be copied over instead of rebuilt.

# Elixir build artefacts and fetched dependencies — rebuilt by the Dockerfile.
_build/
deps/
*.ez
erl_crash.dump

# Test coverage and generated docs.
cover/
doc/

# Tests are not part of the release: elixirc_paths only adds test/support under
# MIX_ENV=test, and the image builds with MIX_ENV=prod.
test/

# Assets produced by build tools — regenerated by `mix assets.deploy`.
priv/static/assets/
priv/static/cache_manifest.json
assets/node_modules/
npm-debug.log

# Local tooling and editor noise.
.git/
.gitignore
.elixir_ls/
.lexical/
.vscode/
tmp/
